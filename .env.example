# Paste your AssemblyAI API key after the equals sign (no quotes, no spaces).
# Get one at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Optional: override the LLM Gateway models Surgr uses. Claude is tried first and Surgr
# falls back to the always-available Qwen model when the account has no access.
# SURGR_CLASSIFY_MODEL=claude-haiku-4-5-20251001
# SURGR_REPORT_MODEL=claude-sonnet-4-6
# SURGR_FALLBACK_MODEL=qwen3.5-4b-32k-fast

# Optional: voice for the OR safety announcements (alba, eve, george, jane, jean, mary, michael, anna, charles, paul, vera).
# SURGR_VOICE_ID=george

# Optional: deliver the operative record from the report screen.
# Telegram: create a bot with @BotFather (/newbot) and paste its token. Judges open the bot, press Start, and the PDF is sent to them.
# TELEGRAM_BOT_TOKEN=
# Email via Resend (https://resend.com). Without a verified domain, Resend only delivers to the address on your Resend account.
# RESEND_API_KEY=
# SURGR_EMAIL_FROM=Surgr <onboarding@resend.dev>
